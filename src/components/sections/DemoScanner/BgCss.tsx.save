"use client";

export default function BgCss() {
  // =========================================================================
  // HIER DEINE GENERIERTEN DATEN AUS DEM RUBY-SCRIPT EINTRAGEN
  // =========================================================================
  
  // 1. Die Pixel-Größe (width/height), die das Script für "#art div" generiert hat
  const PIXEL_SIZE = "3px"; 
  
  // 2. Den endlos langen String nach "box-shadow:" aus deiner generierten CSS-Datei
  // (Ich habe hier einen kleinen Cyber-Smiley als Platzhalter eingebaut)
  const BOX_SHADOW_DATA = `
    0px 0px 0px #00f3ff, 15px 0px 0px #00f3ff, 
    0px 15px 0px #00f3ff, 15px 15px 0px #00f3ff,
    -15px 30px 0px #00f3ff, 30px 30px 0px #00f3ff,
    0px 45px 0px #00f3ff, 15px 45px 0px #00f3ff
  `;
  
  // =========================================================================

  return (
    /* 
      Positionierung: 
      right-[15%] = Rechts positioniert (neben dem fließenden Code)
      top-[30%] = Vertikale Höhe
      opacity-20 = "Leicht schattiert" / transparent
      mix-blend-screen = Verschmilzt cool mit dem dunklen Hintergrund wie ein Hologramm
    */
    <div className="absolute right-[15%] top-[30%] opacity-20 mix-blend-screen pointer-events-none z-[5] blur-[0.5px]">
      <div 
        style={{
          width: PIXEL_SIZE,
          height: PIXEL_SIZE,
          background: "transparent",
          boxShadow: BOX_SHADOW_DATA,
	  
        }} 
      />
    </div>
  );
}
