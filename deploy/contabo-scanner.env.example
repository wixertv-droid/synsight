# SynSight Contabo DemoScanner
# Copy to /etc/synsight-demo-scan.env and chmod 600.
# Never commit the real API key or live server IPs.

# Generate with: openssl rand -hex 32
API_KEY=replace-with-a-random-secret

# Listen on the scanner server. Firewall + app allowlist protect this port.
API_BIND=0.0.0.0
API_PORT=5002

# Public IPv4/IPv6 or CIDR of the SynSight main server only.
# Multiple entries are comma-separated.
ALLOWED_CLIENT_IPS=203.0.113.10/32
REQUIRE_CLIENT_ALLOWLIST=true

# Keep health output minimal. Admin test still receives ready/version.
HEALTH_VERBOSE=false

# Free scan results are transient and are not written to disk by default.
PERSIST_RESULTS=false
RESULT_PATH=/var/lib/synsight-demo-scan/results

# Input/load protection.
MAX_BODY_BYTES=16384
MAX_QUERY_LENGTH=160
MAX_CONCURRENT_SCANS=2

# Module timeouts in seconds.
HOLEHE_TIMEOUT=45
MAIGRET_TIMEOUT=55
PHONEINFOGA_TIMEOUT=35

# Optional explicit paths if binaries are not on PATH.
# HOLEHE_BIN=/usr/local/bin/holehe
# MAIGRET_BIN=/usr/local/bin/maigret
# PHONEINFOGA_BIN=/usr/local/bin/phoneinfoga
# TOOL_PATH=/usr/local/bin:/usr/bin:/root/.local/bin:/opt/bin:/app
