# SynSight Contabo DemoScanner
# Copy to /etc/synsight-demo-scan.env and chmod 600.
# Never commit the real API key or live server IPs.

# Generate with: openssl rand -hex 32
API_KEY=replace-with-a-random-secret

# Listen on the scanner server. Firewall + app allowlist protect this port.
API_BIND=0.0.0.0
API_PORT=5002

# Localhost plus public IPv4/IPv6 or CIDR of the SynSight main server only.
# Multiple entries are comma-separated.
ALLOWED_CLIENT_IPS=127.0.0.1/32,::1/128,203.0.113.10/32
REQUIRE_CLIENT_ALLOWLIST=true

# Keep health output minimal. Admin test still receives ready/version.
HEALTH_VERBOSE=false

# Free scan results are transient and are not written to disk by default.
PERSIST_RESULTS=false
RESULT_PATH=/var/lib/synsight-demo-scan/results

# Input/load protection.
MAX_BODY_BYTES=16384
MAX_QUERY_LENGTH=160
MAX_CONCURRENT_SCANS=2

# Email module.
HOLEHE_TIMEOUT=45

# Prioritised username scan. The guest scan checks the best-ranked sites only,
# disables recursive extraction and returns a compact result selection.
MAIGRET_TIMEOUT=45
MAIGRET_TOP_SITES=100
MAIGRET_SITE_TIMEOUT=6
MAIGRET_MAX_CONNECTIONS=20
MAIGRET_RETRIES=0
MAIGRET_MAX_RESULTS=12

# Secondary technical telephone metadata.
PHONEINFOGA_TIMEOUT=25

# Primary public telephone exposure search through the local-only SearXNG.
SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_TIMEOUT=12
PHONE_SEARCH_MAX_QUERIES=2
PHONE_SEARCH_MAX_RESULTS=8
PHONE_SEARCH_CACHE_TTL=21600
# A second number spelling is queried only when the first query returned fewer
# results than this threshold.
PHONE_SEARCH_SECOND_QUERY_THRESHOLD=3

# Optional explicit paths if binaries are not on PATH.
# HOLEHE_BIN=/usr/local/bin/holehe
# MAIGRET_BIN=/usr/local/bin/maigret
# PHONEINFOGA_BIN=/usr/local/bin/phoneinfoga
# TOOL_PATH=/usr/local/bin:/usr/bin:/root/.local/bin:/opt/bin:/app
